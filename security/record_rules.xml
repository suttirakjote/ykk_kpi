<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_ykk_kpi_annual_kpi_user" model="ir.rule">
        <field name="name">KPI/Goal Setting: Own Employee or Department</field>
        <field name="model_id" ref="model_ykk_kpi_annual_kpi"/>
        <field name="domain_force">[
            '|',
            ('employee_id.user_id', '=', user.id),
            ('department_id', 'in', user.employee_ids.department_id.ids)
        ]</field>
        <field name="groups" eval="[(4, ref('group_ykk_kpi_user'))]"/>
    </record>

    <record id="rule_ykk_kpi_annual_kpi_admin" model="ir.rule">
        <field name="name">KPI/Goal Setting: Administrator All</field>
        <field name="model_id" ref="model_ykk_kpi_annual_kpi"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ykk_kpi_admin'))]"/>
    </record>

    <record id="rule_ykk_kpi_department_kpi_user" model="ir.rule">
        <field name="name">Evaluation: Own Employee or Department</field>
        <field name="model_id" ref="model_ykk_kpi_department_kpi"/>
        <field name="domain_force">[
            '|',
            ('employee_id.user_id', '=', user.id),
            ('department_id', 'in', user.employee_ids.department_id.ids)
        ]</field>
        <field name="groups" eval="[(4, ref('group_ykk_kpi_user'))]"/>
    </record>

    <record id="rule_ykk_kpi_department_kpi_admin" model="ir.rule">
        <field name="name">Evaluation: Administrator All</field>
        <field name="model_id" ref="model_ykk_kpi_department_kpi"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ykk_kpi_admin'))]"/>
    </record>

</odoo>
