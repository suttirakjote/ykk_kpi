<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_department_kpi" model="ir.sequence">
            <field name="name">Evaluation Sequence</field>
            <field name="code">ykk.kpi.department.kpi</field>
            <field name="prefix">DE/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ykk_kpi_template" model="ir.sequence">
            <field name="name">KPI Template Sequence</field>
            <field name="code">ykk.kpi.template</field>
            <field name="prefix">KT/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ykk_annual_kpi" model="ir.sequence">
            <field name="name">KPI/Goal Setting Sequence</field>
            <field name="code">ykk.kpi.annual.kpi</field>
            <field name="prefix">AN/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ykk_import_tiger_soft" model="ir.sequence">
            <field name="name">Import HR Data Sequence</field>
            <field name="code">ykk.kpi.import.tiger.soft</field>
            <field name="prefix">TS/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ykk_template_document" model="ir.sequence">
            <field name="name">Template Document Sequence</field>
            <field name="code">ykk.kpi.template.document</field>
            <field name="prefix">TD/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ykk_department_bell_curve" model="ir.sequence">
            <field name="name">Grade Distribution Sequence</field>
            <field name="code">ykk.kpi.department.bell.curve</field>
            <field name="prefix">BC/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>


    </data>
</odoo>
