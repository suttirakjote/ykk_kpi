<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report action -->
    <record id="action_report_template_document" model="ir.actions.report">
        <field name="name">แจ้งการปรับค่าจ้างฯ</field>
        <field name="model">ykk.kpi.template.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ykk_kpi.report_template_document</field>
        <field name="report_file">ykk_kpi.report_template_document</field>
        <field name="print_report_name">"TemplateDoc-%s" % (object.name or "")</field>
        <field name="paperformat_id" ref="ykk_kpi.paperformat_ykk_letter"/>
    </record>

    <!-- QWeb template : 1 หน้า = พนักงาน 1 คน
         เนื้อหาทั้งหมดมาจากแท็บ Document Context ที่ผู้ใช้ตั้งค่าเอง
         rendered[line.id] คือผลลัพธ์หลังแทนค่า placeholder ของพนักงานคนนั้น

         ไม่ใช้ web.external_layout เพื่อคุม header/footer เอง
         (div.header / div.footer จะถูก Odoo ดึงไปทำหัว-ท้ายกระดาษให้อัตโนมัติ) -->
    <template id="report_template_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-foreach="doc.line_ids" t-as="line">
                    <t t-set="content" t-value="rendered.get(line.id, {})"/>
                    <t t-set="company" t-value="doc.company_id"/>

                    <div t-if="doc.show_company_header" class="header ykk-letter"
                         t-attf-style="font-size:{{doc.font_size}}pt;">
                        <div class="row">
                            <div class="col-3">
                                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                     style="max-height:60px;" alt="Logo"/>
                            </div>
                            <div class="col-9 text-end">
                                <strong t-field="company.name"/>
                            </div>
                        </div>
                    </div>

                    <div t-if="doc.show_page_number" class="footer">
                        <div class="text-center" style="font-size:10pt;color:#666;">
                            หน้า <span class="page"/> / <span class="topage"/>
                        </div>
                    </div>

                    <div class="article" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id">
                        <div class="page ykk-letter" t-attf-style="font-size:{{doc.font_size}}pt;">
                            <!-- ฟอนต์ไทย: ใช้ Angsana New ก่อนถ้าติดตั้งไว้
                                 ถ้าไม่มีจึงใช้ Norasi (ฟอนต์เสรีหน้าตาใกล้เคียง) -->
                            <style>
                                .ykk-letter, .ykk-letter * {
                                    font-family: 'Angsana New', 'AngsanaUPC', 'TH Sarabun New',
                                                 'Norasi', 'Garuda', 'Loma', serif;
                                }
                                .ykk-letter { line-height: 1.7; }
                                .ykk-letter p { margin-bottom: .5rem; }
                                .ykk-letter table { page-break-inside: avoid; width: 100%; }
                                .ykk-letter table td, .ykk-letter table th {
                                    padding: 4px 3px; font-size: .85em; line-height: 1.3;
                                }
                            </style>
                            <h4 t-if="content.get('doc_title')" class="text-center mb-4">
                                <span t-out="content.get('doc_title')"/>
                            </h4>
                            <div t-out="content.get('body_html')"/>
                            <div t-out="content.get('footer_html')"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
