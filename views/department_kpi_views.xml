                    </group>
                    <notebook>
                        <page string="Interview Performance">
                            <field name="interview_line_ids">
                                <list editable="top">
                                    <field name="evaluation_state" column_invisible="True"/>
                                    <field name="goal_id" options="{'no_create': True, 'no_open': True}"/>
                                    <button name="action_view_goal" type="object" icon="fa-search" title="View Goal" invisible="not goal_id"/>
                                    <field name="achievement_criteria" optional="show"/>
                                    <field name="weight" optional="show"/>
                                    <field name="comment_employee" optional="show"/>
                                    <field name="performance_result" optional="show"/>
                                    <field name="first_evaluator_comment" optional="show"/>
                                    <field name="first_evaluator_score" optional="show"/>
                                    <field name="comment_second_evaluator" optional="show"/>
                                    <field name="second_evaluator_score" optional="show"/>
                                    <field name="total_score" string="Score"/>
                                </list>
                            </field>
                        </page>
