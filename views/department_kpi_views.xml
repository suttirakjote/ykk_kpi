                        type="object"
                        class="btn-primary"
                        groups="ykk_kpi.group_ykk_kpi_approve"
                        invisible="state != 'evaluated'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancel'"/>
