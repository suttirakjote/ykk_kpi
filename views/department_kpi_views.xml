                            <field name="level_id" options="{'no_create': True}" readonly="1"/>
                            <field name="department_id" options="{'no_create': True}" readonly="1"/>
                        </group>
                        <group>
                            <field name="period_id" options="{'no_create': True}" readonly="group_kpi_user"/>
                            <field name="date" readonly="group_kpi_user"/>
