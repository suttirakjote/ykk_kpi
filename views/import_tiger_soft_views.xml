<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ykk_kpi_import_tiger_soft_form" model="ir.ui.view">
        <field name="name">ykk.kpi.import.tiger.soft.form</field>
        <field name="model">ykk.kpi.import.tiger.soft</field>
        <field name="arch" type="xml">
            <form string="Import Tiger Soft">
                <header>
                    <button name="action_update_data" string="Update Data" type="object"
                        class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="upload_file" filename="upload_filename" widget="binary"/>
                            <field name="upload_filename" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Data">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="year"/>
                                    <field name="employee_code"/>
                                    <field name="employee_id"/>
                                    <field name="date_att"/>
                                    <field name="over_leave_day"/>
                                    <field name="action_type" widget="badge"
                                        decoration-success="action_type == 'insert'"
                                        decoration-info="action_type == 'update'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ykk_kpi_import_tiger_soft_list" model="ir.ui.view">
        <field name="name">ykk.kpi.import.tiger.soft.list</field>
        <field name="model">ykk.kpi.import.tiger.soft</field>
        <field name="arch" type="xml">
            <list string="Import Tiger Soft">
                <field name="name"/>
                <field name="upload_filename"/>
                <field name="user_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_import_tiger_soft" model="ir.actions.act_window">
        <field name="name">Import Tiger Soft</field>
        <field name="res_model">ykk.kpi.import.tiger.soft</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ykk_kpi_import_tiger_soft"
        name="Import Tiger Soft"
        parent="menu_kpi_adjustment_root"
        action="action_import_tiger_soft"
        sequence="40"/>

</odoo>
