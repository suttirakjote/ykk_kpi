<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ykk_kpi_evaluation_rule_search" model="ir.ui.view">
        <field name="name">ykk.kpi.evaluation.rule.search</field>
        <field name="model">ykk.kpi.evaluation.rule</field>
        <field name="arch" type="xml">
            <search string="Evaluation Rules">
                <field name="first_evaluator_id"/>
                <field name="second_evaluator_id"/>
                <field name="user_id"/>
            </search>
        </field>
    </record>

    <record id="view_ykk_kpi_evaluation_rule_list" model="ir.ui.view">
        <field name="name">ykk.kpi.evaluation.rule.list</field>
        <field name="model">ykk.kpi.evaluation.rule</field>
        <field name="arch" type="xml">
            <list string="Evaluation Rules" sample="1" editable="top" multi_edit="1">
                <field name="first_evaluator_id" widget="many2one_avatar_user" options="{'no_create': True}" required="1"/>
                <field name="second_evaluator_id" widget="many2one_avatar_user" options="{'no_create': True}" required="1"/>
                <field name="user_id" widget="many2one_avatar_user" options="{'no_create': True}" required="1"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_ykk_kpi_evaluation_rule" model="ir.actions.act_window">
        <field name="name">Evaluation Rule</field>
        <field name="res_model">ykk.kpi.evaluation.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Evaluation Rule.
            </p>
        </field>
    </record>

    <menuitem id="menu_ykk_kpi_evaluation_rule"
        name="Evaluation Rule"
        parent="menu_ykk_kpi_configuration"
        action="action_ykk_kpi_evaluation_rule"
        sequence="17"/>

</odoo>
